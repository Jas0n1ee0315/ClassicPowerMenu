    <string name="settings_quick_access_wallet_switch">顯示快速存取錢包</string>
    <string name="settings_quick_access_wallet_header_payment">信用卡</string>
    <string name="settings_quick_access_wallet_loyalty_cards">會員卡</string>
    <string name="settings_quick_access_wallet_change_settings_in_pay">在 Google 錢包中變更設定</string>
    <string name="settings_quick_access_wallet_change_settings_in_pay_desc">變更信用卡順序、預設卡片及付款行為等設定</string>
    <string name="settings_quick_access_wallet_access_while_locked_desc">鎖定時也能顯示會員卡預覽。關閉後，開啟預覽或 Google 錢包前會先要求解鎖</string>
    <string name="settings_quick_access_wallet_hide_card_number_when_locked">鎖定時模糊信用卡卡號</string>
    <string name="settings_quick_access_wallet_auto_switch_service">自動切換預設付款方式</string>
    <string name="settings_quick_access_wallet_auto_switch_service_desc">開啟 CPM 時自動將預設付款方式切換為所選的服務。<b>注意：只有在你的錢包應用程式不是「預設感應付款」應用程式時才需要開啟</b></string>
    <string name="settings_quick_access_wallet_auto_switch_service_select">選擇要自動切換的服務</string>
    <string name="settings_quick_access_wallet_auto_switch_service_loading">正在載入 NFC 模擬服務…</string>
    <string name="settings_quick_access_wallet_auto_switch_service_error_no_services">找不到 NFC 模擬服務</string>
    <string name="settings_quick_access_wallet_show_loyalty_cards">顯示會員卡</string>
    <string name="settings_quick_access_wallet_show_loyalty_cards_desc">從 Google 錢包載入會員卡，並顯示在快速存取錢包中</string>
    <string name="settings_quick_access_wallet_manage">管理帳號與會員卡</string>
    <string name="settings_quick_access_wallet_manage_desc">登入帳號，並調整會員卡在快速存取錢包中的順序與顯示／隱藏</string>

    <string name="settings_quick_access_wallet_manage_logout">登出帳號</string>
    <string name="settings_quick_access_wallet_manage_logout_desc">刪除已儲存的會員卡資料及目前的帳號</string>
    <string name="settings_quick_access_wallet_manage_sign_in">需要登入</string>
    <string name="settings_quick_access_wallet_manage_sign_in_desc">如要使用會員卡，你必須透過一般的帳號登入流程登入 Google 帳戶，才能整合 Google 錢包。這是因為使用 Android 系統內建的帳號登入無法存取相關 API。\n\n<b>為了保護你的隱私與安全，錢包資料會加密保存在你的裝置上，絕不會傳送出去，也不會包含在備份中。</b></string>

    <string name="settings_quick_access_wallet_remember_last_card">記住上次選取的卡片</string>
    <string name="settings_quick_access_wallet_remember_last_card_desc">開啟時（預設），下次開啟電源選單會自動選取上次使用的信用卡（也就是目前 Google Pay 的預設卡）。關閉後，每次開啟電源選單都會從排序的第一張卡開始。</string>
    <string name="settings_quick_access_wallet_show_preview">顯示會員卡預覽</string>
    <string name="settings_quick_access_wallet_show_preview_desc">不必開啟 Google 錢包，就能顯示會員卡預覽，方便在店內掃描或查看</string>
    <string name="settings_quick_access_wallet_show_code_directly">直接顯示條碼</string>
    <string name="settings_quick_access_wallet_show_code_directly_desc">（實驗性功能）在電源選單的會員卡上直接顯示條碼或 QR 碼，取代原本的標誌，且不會調整螢幕亮度。輕觸卡片仍會開啟預覽或 Google 錢包。若關閉「允許鎖定時使用會員卡」，鎖定時會顯示原本的卡面</string>
    <string name="settings_quick_access_wallet_access_while_locked">允許鎖定時使用會員卡</string>
    <string name="settings_quick_access_wallet_hide_card_number_when_locked_desc">開啟快速存取錢包且裝置處於鎖定狀態時，將信用卡卡號模糊處理。<b>注意：不一定適用於所有卡片或錢包服務。</b></string>
    <string name="settings_quick_access_wallet_loyalty_cards_not_supported">不支援會員卡</string>
    <string name="settings_quick_access_wallet_loyalty_cards_not_supported_desc">很抱歉，目前只有原版 Google 錢包應用程式支援會員卡，整合後的「GPay」應用程式不支援。請安裝並設定 Google 錢包，才能在快速存取錢包中使用會員卡。</string>
    <string name="settings_device_controls_switch">顯示裝置控制</string>
    <string name="settings_device_controls_access_while_locked">允許鎖定時使用</string>
    <string name="settings_device_controls_access_while_locked_desc">允許在鎖定時操作裝置控制。這<b>不會</b>允許在鎖定時新增或編輯控制項</string>
    <string name="settings_device_controls_auto_reconnect">狀態載入失敗時自動重新連線</string>
    <string name="settings_device_controls_auto_reconnect_desc">開啟電源選單後，如果同一個應用程式（例如 Home Assistant）有一半以上的控制項顯示「無法載入狀態」，就自動重新啟動該應用程式並重新載入，通常幾秒內就會恢復。適用於切換網路後應用程式與伺服器的連線卡住的情況。<b>注意：重新啟動時，該應用程式的背景功能（例如位置回報）會中斷幾秒；60 秒內最多觸發一次。</b></string>
    <string name="color_picker_unavailable">目前的桌布無法使用桌布色彩選擇器</string>
    <string name="settings_quick_access_wallet_loading">正在載入會員卡…</string>
    <string name="settings_quick_access_wallet_manage_error_no_cards">尚未載入任何會員卡。\n請按同步按鈕，從 Google 錢包載入會員卡！</string>
    <string name="settings_quick_access_wallet_manage_error_generic">載入會員卡時發生錯誤</string>
    <string name="settings_developer_options_content_creator_mode">內容創作者模式</string>
    <string name="settings_developer_options_content_creator_mode_desc">開啟後一律模糊信用卡卡號，並在<b>預覽中</b>將會員卡顯示為假的條碼（如需一律開啟預覽，請另外啟用）。適合拍攝螢幕截圖或影片，避免不小心洩漏卡片資訊。\n<b>警告：開啟此模式時請勿實際使用會員卡，可能會造成店家系統錯誤。</b></string>
    <string name="settings_accessibility_warning">尚未啟用無障礙服務</string>
    <string name="settings_accessibility_warning_desc">Classic Power Menu 需要無障礙服務來偵測長按電源鍵事件。輕觸即可啟用。</string>
