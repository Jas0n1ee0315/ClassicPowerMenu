<?xml version="1.0" encoding="utf-8"?>
<!-- 手動新增 / 編輯會員卡的對話框：名稱、副標題、卡號、條碼類型，下方即時預覽條碼 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="@dimen/margin_8"
        android:paddingEnd="24dp">

        <!-- 會員卡名稱（必填）：電源選單的主標題 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/loyalty_card_add_name_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_quick_access_wallet_manage_add_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/loyalty_card_add_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- 副標題（選填）：電源選單顯示「名稱 • 副標題」 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/loyalty_card_add_subtitle_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_8"
            android:hint="@string/settings_quick_access_wallet_manage_add_subtitle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/loyalty_card_add_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- 會員卡號（必填）：條碼內容 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/loyalty_card_add_number_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_8"
            android:hint="@string/settings_quick_access_wallet_manage_add_number">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/loyalty_card_add_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="text|textNoSuggestions"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- 條碼類型：下拉選單 -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/loyalty_card_add_type_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_8"
            android:hint="@string/settings_quick_access_wallet_manage_add_type">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/loyalty_card_add_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- 條碼即時預覽（白底，與實際顯示一致；卡號格式不符時隱藏） -->
        <FrameLayout
            android:id="@+id/loyalty_card_add_preview_container"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="@dimen/margin_16"
            android:layout_marginBottom="@dimen/margin_8"
            android:background="@android:color/white"
            android:padding="@dimen/margin_8"
            android:visibility="gone">

            <ImageView
                android:id="@+id/loyalty_card_add_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

        </FrameLayout>

    </LinearLayout>

</ScrollView>
