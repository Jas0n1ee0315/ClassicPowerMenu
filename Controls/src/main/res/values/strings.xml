    <string name="controls_pin_verify">驗證「<xliff:g id="device" example="Backdoor lock">%s</xliff:g>」</string>
    <!-- Controls PIN entry dialog, title when 1st attempt failed [CHAR LIMIT=30] -->
    <string name="controls_pin_wrong">PIN 碼錯誤</string>
    <!-- Controls PIN entry dialog, waiting to verify [CHAR LIMIT=30] -->
    <string name="controls_pin_verifying">驗證中…</string>
    <!-- Controls PIN entry dialog, text hint [CHAR LIMIT=30] -->
    <string name="controls_pin_instructions">輸入 PIN 碼</string>
    <!-- Controls PIN entry dialog, text hint, retry [CHAR LIMIT=30] -->
    <string name="controls_pin_instructions_retry">請改用其他 PIN 碼</string>
    <!-- Controls confirmation dialog, waiting to confirm [CHAR LIMIT=30] -->
    <string name="controls_confirmation_confirming">確認中…</string>
    <!-- Controls confirmation dialog, user prompt [CHAR LIMIT=NONE] -->
    <string name="controls_confirmation_message">確認變更「<xliff:g id="device" example="Backdoor lock">%s</xliff:g>」</string>

    <!-- Tooltip to show in management screen when there are multiple structures [CHAR_LIMIT=50] -->
    <string name="controls_structure_tooltip">滑動即可查看更多</string>

    <!-- Message to tell the user to wait while systemui attempts to load a set of
         recommended controls [CHAR_LIMIT=60] -->
    <string name="controls_seeding_in_progress">正在載入建議項目</string>

    <!-- Title for media controls [CHAR_LIMIT=50] -->
    <string name="controls_media_title">媒體</string>
    <!-- Explanation for closing controls associated with a specific media session [CHAR_LIMIT=NONE] -->
    <string name="controls_media_close_session">隱藏目前的工作階段。</string>
    <!-- Explanation that controls associated with a specific media session are active [CHAR_LIMIT=NONE] -->
    <string name="controls_media_active_session">無法隱藏目前的工作階段。</string>
    <!-- Label for a button that will hide media controls [CHAR_LIMIT=30] -->
    <string name="controls_media_dismiss_button">關閉</string>
    <!-- Label for button to resume media playback [CHAR_LIMIT=NONE] -->
    <string name="controls_media_resume">繼續播放</string>
    <!-- Label for button to go to media control settings screen [CHAR_LIMIT=30] -->
    <string name="controls_media_settings_button">設定</string>

    <!-- Error message indicating that a control timed out while waiting for an update [CHAR_LIMIT=30] -->
    <string name="controls_error_timeout">未啟用，請檢查應用程式</string>
    <!-- Error message indicating that an unspecified error occurred while getting the status, and
         a retry will be attempted [CHAR LIMIT=30] -->
    <string name="controls_error_retryable">發生錯誤，正在重試…</string>
    <!-- Error message indicating that the control is no longer available in the application [CHAR LIMIT=30] -->
    <string name="controls_error_removed">找不到</string>
    <!-- Title for dialog indicating that the control is no longer available in the application [CHAR LIMIT=30] -->
    <string name="controls_error_removed_title">無法使用控制項</string>
    <!-- Message body for dialog indicating that the control is no longer available in the application [CHAR LIMIT=NONE] -->
    <string name="controls_error_removed_message">無法存取「<xliff:g id="device" example="Backdoor lock">%1$s</xliff:g>」。請檢查「<xliff:g id="application" example="Google Home">%2$s</xliff:g>」應用程式，確認控制項仍可使用，且應用程式設定沒有變更。</string>
    <!-- Text for button to open the corresponding application [CHAR_LIMIT=20] -->
    <string name="controls_open_app">開啟應用程式</string>
    <!-- Error message indicating that an unspecified error occurred while getting the status [CHAR LIMIT=30] -->
    <string name="controls_error_generic">無法載入狀態</string>
    <!-- Error message indicating that a control action failed [CHAR_LIMIT=30] -->
    <string name="controls_error_failed">發生錯誤，請再試一次</string>
    <!-- Stateless control message informing the user that a routine has started [CHAR_LIMIT=30] -->
    <string name="controls_in_progress">處理中</string>
    <!-- Tooltip informing user where the recently added controls are [CHAR_LIMIT=100] -->
    <string name="controls_added_tooltip">按住電源鍵即可查看新的控制項</string>

    <!-- Controls menu, add [CHAR_LIMIT=30] -->
    <string name="controls_menu_add">新增控制項</string>
    <!-- Controls menu, edit [CHAR_LIMIT=30] -->
    <string name="controls_menu_edit">編輯控制項</string>
    <!-- 強制繁中的確定 / 取消（取代會跟隨系統語言的 android.R.string.ok / cancel） -->
    <string name="controls_ok">確定</string>
    <string name="controls_cancel">取消</string>
    <string name="save">儲存</string>
    <string name="loading">載入中…</string>

    <!-- accessibility label for paging indicator in quick settings [CHAR LIMITi=NONE] -->
    <string name="accessibility_quick_settings_page">第 <xliff:g name="current_page" example="1">%1$d</xliff:g> 頁，共 <xliff:g name="num_pages" example="2">%2$d</xliff:g> 頁</string>
    <string name="accessibility_menu">選單</string>
    <string name="accessibility_desc_close">關閉</string>
</resources>
