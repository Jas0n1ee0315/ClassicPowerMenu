    <string name="controls_favorite_rearrange">按住並拖曳即可調整控制項順序</string>

    <!-- Controls management editing screen, text to indicate that all the favorites have been removed [CHAR LIMIT=NONE] -->
    <string name="controls_favorite_removed">已移除所有控制項</string>

    <!-- Controls management favorites screen, See other apps with changes made [CHAR LIMIT=NONE] -->
    <string name="controls_favorite_toast_no_changes">變更未儲存</string>

    <!-- Controls management favorites screen. See other apps button [CHAR LIMIT=30] -->
    <string name="controls_favorite_see_other_apps">查看其他應用程式</string>

    <!-- Controls management controls screen error on load message [CHAR LIMIT=NONE] -->
    <string name="controls_favorite_load_error">無法載入控制項。請檢查「<xliff:g id="app" example="System UI">%s</xliff:g>」應用程式，確認應用程式設定沒有變更。</string>
