<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_weight="1"
    android:layout_height="@dimen/control_height"
    android:paddingStart="@dimen/control_padding"
    android:paddingEnd="@dimen/control_padding"
    android:paddingTop="@dimen/control_padding_vertical"
    android:paddingBottom="@dimen/control_padding_vertical"
    android:clickable="false"
    android:focusable="true"
    android:screenReaderFocusable="true"
    android:stateListAnimator="@animator/control_state_list_animator"
    android:layout_marginLeft="@dimen/control_base_item_margin"
    android:layout_marginRight="@dimen/control_base_item_margin"
    android:background="@drawable/control_background">

    <!-- 排版：左欄 = 圖示（在整個按鈕內垂直置中）；右欄 = 裝置名稱（title）→ 狀態（status）→ 副標題（空白時隱藏），
         三者組成 packed 垂直鏈，並且左緣對齊（都接在圖示右側、相同的 paddingStart）。
         按鈕維持固定高度（control_height = 69dp），內容於上下 padding 之間置中，所以調整排版不會改變按鈕高度。 -->
    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/control_icon_size"
        android:layout_height="@dimen/control_icon_size"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
    <!-- 圖示原本依裝置名稱置中（top/bottom 接 @id/title），改成依整個按鈕垂直置中 -->

    <!-- 裝置名稱：原本在圖示下方，改到圖示右側（原狀態文字的位置），與圖示垂直置中 -->
    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Control.Title"
        android:paddingStart="@dimen/control_status_padding"
        android:paddingEnd="@dimen/control_padding_adjustment"
        android:clickable="false"
        android:focusable="false"
        android:maxLines="1"
        android:ellipsize="end"
        android:textDirection="locale"
        android:textFontWeight="500"
        app:layout_constraintStart_toEndOf="@id/icon"
        app:layout_constraintEnd_toStartOf="@id/favorite"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/status"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- 狀態：放在裝置名稱下方，左緣與裝置名稱對齊（同樣接在圖示右側、paddingStart 相同） -->
    <TextView
        android:id="@+id/status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Control.Status"
        android:paddingStart="@dimen/control_status_padding"
        android:paddingEnd="@dimen/control_padding_adjustment"
        android:layout_marginTop="2dp"
        android:screenReaderFocusable="false"
        android:clickable="false"
        android:focusable="false"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:textFontWeight="500"
        android:marqueeRepeatLimit = "marquee_forever"
        android:textDirection="locale"
        app:layout_constraintStart_toEndOf="@id/icon"
        app:layout_constraintEnd_toStartOf="@id/favorite"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintBottom_toTopOf="@id/subtitle" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="subtitle,favorite" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Control.Subtitle"
        android:paddingStart="@dimen/control_status_padding"
        android:paddingEnd="@dimen/control_padding_adjustment"
        android:paddingBottom="@dimen/control_padding_adjustment"
        android:clickable="false"
        android:focusable="false"
        android:maxLines="1"
        android:ellipsize="end"
        android:textDirection="locale"
        app:layout_constraintStart_toEndOf="@id/icon"
        app:layout_constraintEnd_toStartOf="@id/favorite"
        app:layout_constraintTop_toBottomOf="@id/status"
        app:layout_constraintBottom_toBottomOf="parent"
        />
    <!-- 副標題原為 constraintTop_toTopOf="@id/favorite"，改為接在狀態下方 -->

    <!-- 勾選框（僅新增 / 排序頁顯示，ControlAdapter 會設為 VISIBLE）：
         固定在按鈕內靠右、上下置中；原本 start 接在副標題後面，副標題隱藏時會跑到文字旁邊。
         電源選單中改為 GONE（原 invisible），文字的 end 約束接在它上面時會退回到按鈕右緣，不會白白少 25dp 寬度。 -->
    <CheckBox
        android:id="@+id/favorite"
        android:visibility="gone"
        android:layout_width="@dimen/controls_management_checkbox_size"
        android:layout_height="@dimen/controls_management_checkbox_size"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:gravity="center"
        android:background="@android:color/transparent"
        android:clickable="false"
        android:selectable="false"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>